{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madmamba.dev/schemas/traceability.schema.json",
  "title": "MadMamba requirement traceability catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements", "tasks"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "source", "implementation", "tests", "documentation", "releaseClaim"],
        "properties": {
          "id": {"type": "string", "pattern": "^((FR|NFR)-[A-Z0-9]+-[0-9]{3}|SEC-[0-9]{3})$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 240},
          "source": {"type": "string", "pattern": "^spec:"},
          "implementation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "documentation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "releaseClaim": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "requirements", "acceptance"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]+-[A-Z0-9]+-[0-9]{3}$"},
          "stage": {"type": "string", "minLength": 1},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "acceptance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
